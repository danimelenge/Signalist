      }
    },
    "Cambia al modo \"Semáforo → Texto\" y escribe los pares de flechas separados por espacio (ej. \"→↘ ↑↗\") para obtener el texto equivalente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to the \"Semaphore ➔ Text\" mode and type the arrow pairs separated by space (e.g., \"➔↘ ↗↗\") to get the equivalent text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia al modo \"Semáforo → Texto\" y escribe los pares de flechas separados por espacio (ej. \"→↘ ↑↗\") para obtener el texto equivalente."
          }
        }
      }
    },
    "Cambia al modo \"Unicode → Texto\" dentro de la pestaña Unicode y escribe los puntos de código separados por espacio (ej. \"U+0048 U+006F U+006C U+0061\") para obtener el texto equivalente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to the \"Unicode ➔ Text\" mode within the Unicode tab and type the code points separated by space (e.g., \"U+0048 U+006F U+006C U+0061\") to get the equivalent text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
