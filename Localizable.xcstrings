            "state" : "translated",
            "value" : "A: 01000001   B: 01000010   a: 01100001\nChaque caractère occupe 8 bits (1 octet), séparés par des espaces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 01000001   B: 01000010   a: 01100001\nOgni carattere occupa 8 bit (1 byte), separati da spazi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
