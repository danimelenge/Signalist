    "A: •−   B: −•••   C: −•−•   D: −••   E: •\nS: •••   O: −−−   (SOS = ••• −−− •••)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: •−   B: −•••   C: −•−•   D: −••   E: •\nS: •••   O: −−−   (SOS = ••• −−− •••)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: •−   B: −•••   C: −•−•   D: −••   E: •\nS: •••   O: −−−   (SOS = ••• −−− •••)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: •−   B: −•••   C: −•−•   D: −••   E: •\nS: •••   O: −−−   (SOS = ••• −−− •••)"
          }
        }
      }
    },
    "A: →↘↓   B: →↓\nCada letra son dos flechas: primero el brazo derecho, luego el izquierdo. \"/\" separa palabras." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: →↘↓   B: →↓\nEach letter is two arrows: first the right arm, then the left. \"/\" separates words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: →↘↓   B: →↓\nCada letra son dos flechas: primero el brazo derecho, luego el izquierdo. \"/\" separa palabras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: →↘↓   B: →↓\nCada letra são duas setas: primeiro o braço direito, depois o esquerdo. \"/\" separa palavras."
          }
        }
      }
    },
    "A: ⠁   B: ⠃   C: ⠉   D: ⠙   E: ⠑\n⠠ antes de una letra = mayúscula\n⠼ antes de un número = modo numérico (ej. ⠼⠁ = \"1\")" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ⠁ B: ⠃ C: ⠉ D: ⠙ E: ⠑\n⠠ before a letter = uppercase\n⠼ before a number = number mode (e.g., ⠼⠁ = \"1\")"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ⠁   B: ⠃   C: ⠉   D: ⠙   E: ⠑\n⠠ antes de una letra = mayúscula\n⠼ antes de un número = modo numérico (ej. ⠼⠁ = \"1\")"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ⠁   B: ⠃   C: ⠉   D: ⠙   E: ⠑\n⠠ antes de uma letra = maiúscula\n⠼ antes de um número = modo numérico (ex.: ⠼⠁ = \"1\")"
          }
        }
      }
    },
    "A: 65   B: 66   a: 97   0: 48   Espacio: 32\nCada carácter se representa como un número decimal, separado por espacios." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 65 B: 66 a: 97 0: 48 Space: 32\nEach character is represented as a decimal number, separated by spaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 65   B: 66   a: 97   0: 48   Espacio: 32\nCada carácter se representa como un número decimal, separado por espacios."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 65   B: 66   a: 97   0: 48   Espaço: 32\nCada caractere é representado por um número decimal, separado por espaços."
          }
        }
      }
    },
    "A: 01000001   B: 01000010   a: 01100001\nCada carácter ocupa 8 bits (1 byte), separados por espacios." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 01000001 B: 01000010 a: 01100001\nEach character occupies 8 bits (1 byte), separated by spaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 01000001   B: 01000010   a: 01100001\nCada carácter ocupa 8 bits (1 byte), separados por espacios."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: 01000001   B: 01000010   a: 01100001\nCada caractere ocupa 8 bits (1 byte), separados por espaços."
          }
        }
      }
    },
    "A: Alfa   B: Bravo   C: Charlie   D: Delta   E: Echo\nLos números también tienen palabra propia (ej. \"1\" = \"One\")." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: Alfa B: Bravo C: Charlie D: Delta E: Echo\nNumbers also have their own code word (e.g., \"1\" = \"One\")."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: Alfa   B: Bravo   C: Charlie   D: Delta   E: Echo\nLos números también tienen palabra propia (ej. \"1\" = \"One\")."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: Alfa   B: Bravo   C: Charlie   D: Delta   E: Echo\nOs números também têm palavra própria (ex.: \"1\" = \"One\")."
          }
        }
      }
    },
    "A: U+0041   a: U+0061   Espacio: U+0020\nTambién soporta emojis y símbolos fuera del rango ASCII (ej. 🎉 = U+1F389)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: U+0041 a: U+0061 Space: U+0020\nAlso supports emojis and non-ASCII symbols (e.g. 🎉 = U+1F389)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: U+0041   a: U+0061   Espacio: U+0020\nTambién soporta emojis y símbolos fuera del rango ASCII (ej. 🎉 = U+1F389)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: U+0041   a: U+0061   Espaço: U+0020\nTambém suporta emojis e símbolos fora do intervalo ASCII (ex.: 🎉 = U+1F389)."
          }
        }
      }
    },
    "A: ᚐ   B: ᚁ   C: ᚉ   S: ᚄ\nSe escribe sin espacios entre letras. K, V, W, J/Y, X/Z se aproximan a la letra de sonido más cercano, ya que el Ogham original solo tiene 20 letras." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ᚐ   B: ᚁ   C: ᚉ   S: ᚄ\nWritten without spaces between letters. K, V, W, J/Y, X/Z approximate the letter with the closest sound, as the original Ogham only has 20 letters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ᚐ   B: ᚁ   C: ᚉ   S: ᚄ\nSe escribe sin espacios entre letras. K, V, W, J/Y, X/Z se aproximan a la letra de sonido más cercano, ya que el Ogham original solo tiene 20 letras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ᚐ   B: ᚁ   C: ᚉ   S: ᚄ\nEscreve-se sem espaços entre as letras. K, V, W, J/Y, X/Z aproximam-se da letra de som mais próximo, pois o Ogham original tem apenas 20 letras."
          }
        }
      }
    },
    "A: ᚨ   B: ᛒ   F: ᚠ   R: ᚱ\nSe escriben sin espacios entre letras. C, Q, V, X, Y se aproximan a la runa de sonido más cercano, ya que el Futhark original solo tiene 24 runas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ᚨ   B: ᛒ   F: ᚠ   R: ᚱ\nWritten without spaces between letters. C, Q, V, X, Y approximate the rune with the closest sound, as the original Futhark only has 24 runes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ᚨ   B: ᛒ   F: ᚠ   R: ᚱ\nSe escriben sin espacios entre letras. C, Q, V, X, Y se aproximan a la runa de sonido más cercano, ya que el Futhark original solo tiene 24 runas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A: ᚨ   B: ᛒ   F: ᚠ   R: ᚱ\nEscrevem-se sem espaços entre as letras. C, Q, V, X, Y aproximam-se da runa de som mais próximo, pois o Futhark original tem apenas 24 runas."
          }
        }
      }
    },
